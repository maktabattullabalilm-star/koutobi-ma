# ============================================================
# Per-client environment — created as clients/<slug>/.env
# NEVER commit this file. NEVER copy its values into meta.json.
# Run: scripts/new-client.sh <slug> "<store name>" <domain>
# ============================================================

# ---------- Identity (non-secret, mirrors meta.json) ----------
CLIENT_SLUG=__SLUG__
CLIENT_DOMAIN=__DOMAIN__

# ---------- Supabase: browser (public) ----------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# ---------- Supabase: server, CLI, MCP ----------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Dashboard → Account → Access Tokens (starts with sbp_)
SUPABASE_ACCESS_TOKEN=sbp_YOUR_PERSONAL_ACCESS_TOKEN
# Project Settings → Database → Connection string (session pooler).
# Only needed to bootstrap a fresh database; keep it secret.
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

# ---------- Cloudflare: CLI, deploy, MCP ----------
# My Profile → API Tokens. Scope it to this account only:
# Workers Scripts:Edit, Cloudflare R2:Edit, Zone:Read, DNS:Edit.
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID

# ---------- Cloudflare R2 (image storage) ----------
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_R2_BUCKET
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXX.r2.dev
VITE_R2_PUBLIC_URL=https://pub-XXXXXXXXXXXX.r2.dev

# ---------- Optional ----------
# Image CDN template, e.g. https://img.example.com/cdn-cgi/image
VITE_IMAGE_CDN=
# Error reporting endpoint (console-only when empty)
VITE_ERROR_ENDPOINT=

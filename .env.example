# ============================================================
#  كُتُبِي.ما — Environment template
#  Copy this file to `.env` (local dev) and configure the
#  matching variables in the Netlify dashboard for production.
# ============================================================

# ---------- Supabase (frontend, public) ----------
# Project URL + anon (publishable) key from:
#   Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

# ---------- Cloudflare R2 (public image URL) ----------
# The public bucket URL that serves stored book covers.
# e.g. https://pub-XXXXXXXXXXXX.r2.dev  (or your custom domain)
# Left empty = image upload disabled in dashboard (use direct URLs instead).
VITE_R2_PUBLIC_URL=

# ---------- Server-side only (Netlify functions) ----------
# These are NEVER exposed to the browser.
# Set them in Netlify:  Site settings → Environment variables.
# NOTE: no service-role key needed — the upload function verifies
# admins via the anon key + RLS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY

R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=koutobi-ma
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXX.r2.dev
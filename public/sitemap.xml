<?xml version="1.0" encoding="UTF-8"?>
<!-- Static shell: main routes. Book URLs (/book/:id) are client-rendered;
     extend scripts/generate-sitemap.mjs (tracked follow-up) to append them
     from the DB at build time. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>/catalog</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>/cart</loc><changefreq>monthly</changefreq><priority>0.3</priority></url>
  <url><loc>/checkout</loc><changefreq>monthly</changefreq><priority>0.3</priority></url>
</urlset>

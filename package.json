{
  "name": "koutobi-ma",
  "private": true,
  "version": "1.1.10",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "netlify dev",
    "build": "vite build",
    "cf:deploy": "npm run verify && npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "NODE_ENV=test vitest run",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:watch": "NODE_ENV=test vitest",
    "test:local": "npm test && npm run build",
    "lint": "eslint src netlify/functions worker",
    "format": "prettier --write src netlify/functions/_lib worker index.html",
    "format:check": "prettier --check src netlify/functions/_lib worker index.html",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:no-secrets && npm run check:version && npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "check:no-secrets": "bash scripts/check-no-secrets.sh",
    "check:version": "node scripts/check-version.mjs",
    "clients": "bash scripts/clients-list.sh",
    "client:new": "bash scripts/new-client.sh",
    "client:use": "bash scripts/use-client.sh",
    "client:deploy": "bash scripts/deploy.sh",
    "functions:dev": "netlify functions:invoke --name upload-image"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@supabase/supabase-js": "^2.45.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wrangler": "^4.151.1"
  }
}

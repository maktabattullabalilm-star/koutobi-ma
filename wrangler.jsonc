{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koutobi-ma",
  "compatibility_date": "2026-10-17",
  "main": "worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
